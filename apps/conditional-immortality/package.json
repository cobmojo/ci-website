{
  "name": "conditional-immortality",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3210",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test:a11y": "playwright test --project=accessibility --project=accessibility-mobile",
    "test:text-geometry": "playwright test --project=geometry-chromium --project=geometry-firefox --project=geometry-webkit",
    "test:browser": "playwright test --project=chromium-desktop --project=chromium-mobile --project=accessibility --project=accessibility-mobile --project=firefox-smoke --project=webkit-smoke --project=geometry-chromium --project=geometry-firefox --project=geometry-webkit --project=visual --project=interaction",
    "test:interaction": "playwright test --project=interaction",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:smoke": "playwright test --project=firefox-smoke --project=webkit-smoke",
    "test:preview": "playwright test --project=preview"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.8",
    "@ci/content": "workspace:*",
    "@ci/content-schema": "workspace:*",
    "@ci/search": "workspace:*",
    "@ci/ui": "workspace:*",
    "@tanstack/react-form": "1.33.2",
    "@tanstack/react-table": "8.21.3",
    "next": "16.2.12",
    "next-mdx-remote": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "16.3.2",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "30.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "unist-util-visit": "^5.1.0",
    "vitest": "4.1.10"
  }
}
