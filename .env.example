# Every environment variable this site reads, with safe example values.
#
# Copy to `.env.local` for local work if you want to override anything. Nothing
# here is required to run `bun run dev`, `bun run validate` or the browser
# suites — the scripts that need the localhost opt-out set it themselves.
#
# No real credential belongs in this file, and `.env.local` is git-ignored.
# The launch runbook (docs/launch-runbook.md) says which of these a production
# deployment must set, and what happens if it does not.

# ---------------------------------------------------------------------------
# Identity. Required for a release build.
# ---------------------------------------------------------------------------

# The exact canonical production origin. Decides every canonical link, every
# sitemap entry, `Host` and `Sitemap` in robots.txt, every Open Graph URL, the
# address printed on the three downloads, and the destination encoded in the
# printed handout's QR code.
#
# Scheme + host (+ port) only: a path, a query, a fragment, credentials or a
# non-https scheme are all refused at build time. Decide apex vs www before the
# first build — changing it later needs a rebuild, not a redeploy.
#
# A build that sets neither this nor NEXT_PUBLIC_ALLOW_LOCALHOST_SITE_URL fails
# with an actionable message, on purpose. So does `next start`: `next.config.ts`
# resolves the origin when it loads, and the server loads it on every boot, so
# this has to be set for the running process as well as for the build — and to
# the same value, since the build baked it in.
NEXT_PUBLIC_SITE_URL=https://example.org

# Declares "this build is served from localhost". Set by `bun run dev`, by the
# validate chain and by the browser suites; never set for a release build.
# NEXT_PUBLIC_ALLOW_LOCALHOST_SITE_URL=1

# `production` or `preview`. A preview deployment sends
# `X-Robots-Tag: noindex, nofollow` and answers robots.txt by *allowing*
# crawling, which is deliberate: a crawler has to be able to fetch the response
# to obey the header on it, and a page blocked in robots.txt keeps its noindex
# unread and can still surface as a URL-only result. The header is what removes
# a preview URL; the allow is what lets the header be read. Provider-neutral;
# `VERCEL_ENV` is honoured too where it exists.
SITE_ENV=production

# ---------------------------------------------------------------------------
# The correction form. The site's only write.
# ---------------------------------------------------------------------------

# Which store receives submissions: `filesystem`, `http` or `memory`.
#
#   filesystem  a JSON Lines file per calendar month. Safe only where the
#               directory outlives the process and the deployment, which is
#               why production additionally requires the acknowledgement below.
#   http        POSTs each record to an endpoint you own. The right choice on
#               any serverless, containerised or multi-instance host, and it
#               ties the site to no vendor.
#   memory      tests only. Refused in production by name.
FEEDBACK_STORE=filesystem

# filesystem only. Absolute in production, because `process.cwd()` is the
# host's choice and differs between a build step and a running server.
FEEDBACK_STORE_DIR=/var/lib/conditional-immortality/feedback

# filesystem only, and required in production. Setting it to 1 is you stating
# that the directory above survives a restart and a redeploy. Nothing in the
# code can check that; if it is not true, submissions are lost silently, which
# is the one failure this whole arrangement exists to prevent.
# FEEDBACK_STORE_DURABLE=1

# http only. Must be https: a correction carries a reader's words and, if they
# chose to give them, a name and an email address.
# FEEDBACK_STORE_URL=https://collector.example.org/feedback

# http only. Sent as `Authorization: Bearer …`. A secret: set it in the
# deployment platform, never in a file.
# FEEDBACK_STORE_TOKEN=

# How many proxies sit in front of this origin. The rate limiter reads the
# `X-Forwarded-For` entry that many hops from the right, because everything to
# the left of it is whatever the client chose to send. 1 is the shape of every
# managed platform; 0 means nothing is in front and no forwarding header is
# believed — and with nothing to key on, the limiter falls back to one shared
# allowance for the whole site: five submissions per ten minutes in total. Only
# set 0 if this process is genuinely directly exposed.
FEEDBACK_TRUSTED_PROXY_HOPS=1

# Optional. When set, one line per stored submission is logged carrying the id
# and the feedback type — never the message, the name or the email address. It
# does not send mail: no mail provider is wired up, deliberately, so that a
# delivery failure can never look like a submission failure.
# FEEDBACK_NOTIFY_EMAIL=owner@example.org

# ---------------------------------------------------------------------------
# Tests. Not read by the application.
# ---------------------------------------------------------------------------

# Point the browser suites at an already-deployed origin. Set it and no local
# server is started: `bun run test:preview` is the wrapper.
# PLAYWRIGHT_BASE_URL=https://preview.example.org

# The port the local test server binds. Override it when two checkouts of this
# repository are testing at once, or they collide and one measures the other's
# build.
# PLAYWRIGHT_PORT=3211
