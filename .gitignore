# Private source material: the original DOCX and any derived private artefacts.
# See docs/rights-audit.md and /original-document for the rationale.
#
# The rights audit withholds the source document because it opens with a
# personal email address and phone number and carries thirty editorial comments
# by named third parties who never consented to publication. That reasoning
# applies to this repository too, which is public — so the three derived
# artefacts that carry those comments are ignored as well. All four are outputs
# of `bun run source:import`; nothing in the build, the validation chain or any
# test reads them, and `pii-scan.ts` fails if one is ever tracked again.
private/source/*.docx
private/source/*.doc
private/source/source-comments.json
private/source/source-elements.json
private/source/source-text-redacted.md
.feedback-store/
reports/

# Regenerated per-command with different contents each time. The stable half is
# committed as apps/conditional-immortality/types/next-env.d.ts, so this is
# anchored: written bare it would match that file too.
/apps/conditional-immortality/next-env.d.ts

# The animations.dev installer writes the same skills into a directory for every
# agent on the machine. Only Claude Code's copy is committed, in .claude/skills/;
# the rest work the same from disk.
/.cursor/
/.codex/
/.opencode/
/.gemini/

# Transient per-session lock written by the scheduled-tasks tooling.
.claude/scheduled_tasks.lock
