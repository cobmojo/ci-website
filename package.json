{
  "name": "conditional-immortality-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:a11y": "turbo run test:a11y",
    "content:validate": "bun run scripts/conditional-immortality/validate-content.ts",
    "content:audit": "bun run scripts/conditional-immortality/content-audit.ts",
    "content:pii": "bun run scripts/conditional-immortality/pii-scan.ts",
    "content:links": "bun run scripts/conditional-immortality/link-check.ts",
    "source:import": "bun run scripts/conditional-immortality/import-source.ts",
    "validate": "bun run format:check && bun run lint && bun run typecheck && bun run content:validate && bun run content:audit && bun run test && bun run build && bun run content:pii && bun run content:links",
    "ci": "bun run validate && bun run test:browser",
    "test:text-geometry": "turbo run test:text-geometry",
    "test:browser": "turbo run test:browser"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "^1.3.0",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "@ci/content": "workspace:*",
    "@ci/content-schema": "workspace:*",
    "@ci/search": "workspace:*"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
